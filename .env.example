# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Admin token: unlocks /admin/ (create/revoke per-project laya_... tokens). The old shared token
# keeps working for callers too. Empty = no auth at all and no token admin (local use only).
LAYA_TOKEN=

# Port the service listens on (compose: the port published by the load balancer).
LAYA_PORT=9120

# Compose only: copies of the service behind nginx.
LAYA_REPLICAS=1

# Cap torch CPU threads (default: torch decides). Set to the CPU cores the container/host really gives you.
# Also changeable on the /admin/ page (saved; other replicas apply it on restart).
# LAYA_TORCH_THREADS=

# run.bat only (compose sets these itself): bind address, load both models at start (1), use only downloaded weights (1).
# LAYA_HOST=127.0.0.1
# LAYA_WARM=1
# LAYA_OFFLINE=0
# Where project tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# LAYA_TOKENS_FILE=tokens.json
# LAYA_WEB_DIR=web
